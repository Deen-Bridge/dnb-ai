# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Service API key — required in production, shared between DeenBridge backend/frontend and this service
# Generate a long random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SERVICE_API_KEY=your_service_api_key_here

# Set to true to disable API-key authentication for local development
# AUTH_DISABLED=false

# AI model configuration (optional - defaults shown)
# MODEL_NAME=gemini-2.5-flash
# TEMPERATURE=0.7
# TOP_P=0.8
# TOP_K=40
# MAX_OUTPUT_TOKENS=2048

# Server
# PORT=8000

# Confidence & abstention policy (optional — defaults shown)
# CONFIDENCE_LOW_THRESHOLD=0.40      # below this the service abstains
# CONFIDENCE_HIGH_THRESHOLD=0.70     # above this it answers without a caveat
# SCHOLAR_QUEUE_THRESHOLD=0.40       # religious answers at or below go to review
# CONFIDENCE_HIGH_STAKES_PENALTY=0.15
# CONFIDENCE_NO_SIGNAL_PRIOR=0.55
# CONFIDENCE_UNVERIFIED_CEILING=0.65

# Scholar review (reviewer endpoints are disabled until the token is set)
# SCHOLAR_REVIEW_TOKEN=generate_a_long_random_value
# REVIEW_EXPORT_PATH=data/review/reviewed.jsonl
# REDIS_URL=redis://localhost:6379   # durable review queue + memory store

# Chat-history persistence — one of the three options below:
#
# 1) Firestore (recommended for production): chats are stored durably in
#    Firebase and survive indefinitely, so a returning user sees every past
#    conversation. Generate a private key at Firebase console →
#    Project settings → Service accounts → "Generate new private key", then
#    either reference the downloaded JSON file…
#    FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
#    …or inline the JSON on one line (handy on Render/Heroku):
#    FIREBASE_SERVICE_ACCOUNT_JSON={ "type": "service_account", ... }
#    GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json  # or ADC
#    When none of the FIREBASE_* vars is set, the service falls back to Redis.
#
# 2) Redis fallback: history expires after SESSION_TTL_SECONDS (default 86400).
# 3) In-memory fallback: local development only, lost on restart.

# Per-user memory (optional — defaults shown)
# MEMORY_TTL_DAYS=90                 # user-profile and chat-summary TTL in days
# MEMORY_EXTRACTION_ENABLED=true     # background extraction from conversation turns

# Tafsir layer (optional — sensible defaults, no key required)
# QURAN_API_BASE=https://api.quran.com/api/v4
# QURAN_API_TIMEOUT=15
# TAFSIR_MAX_AYAT=10
# TAFSIR_CHAT_EXCERPT_CHARS=2500
# TAFSIR_CHAT_TIMEOUT=20

# Zakat / nisab (optional — the gold price APIs need no key)
# STELLAR_NETWORK=testnet            # or 'public' for mainnet
# ZAKAT_NISAB_USD=6000               # fallback when no gold price is reachable
# NISAB_CACHE_TTL_SECONDS=21600      # how long a fetched gold price is reused
# GOLD_PRICE_TIMEOUT=8

# Purchase history (optional — JWT fetch from dnb-backend when chat has no inline summary)
# DNB_BACKEND_URL=https://dnb-backend-api.onrender.com
# PURCHASE_FETCH_TIMEOUT=10

# Answer feedback loop (optional)
# ADMIN_TOKEN=generate_a_long_random_value   # enables /feedback/stats and /feedback/records
# FEEDBACK_DB_PATH=feedback.db               # SQLite path when REDIS_URL is unset
# FEEDBACK_RATE_LIMIT_MAX=20
# FEEDBACK_RATE_LIMIT_WINDOW=60
